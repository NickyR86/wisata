APP_NAME="SIAP-Wisata"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8017
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta
SESSION_DRIVER=file
# Kredensial pemulihan akses: 30 hari sejak akses terakhir, dapat dicabut saat logout.
SIAP_BROWSER_ACCESS_MINUTES=43200
CACHE_STORE=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
DB_CONNECTION=sqlite

# Aktifkan setelah siap:buat-admin. Data bisnis masih demo selama integrasi bertahap.
SIAP_DATABASE_ACCOUNTS=false

# Penyimpanan fitur bisnis; siapkan dengan siap:siapkan-demo-db for local demo.
SIAP_DATABASE_BUSINESS=false

# Proxy tepercaya (isi bila di balik reverse proxy/load balancer agar HTTPS terdeteksi benar).
# SIAP_TRUSTED_PROXIES=
# Content-Security-Policy: report-only | enforce | off
SIAP_CSP=report-only
