# Contoh konfigurasi PRODUKSI. Salin menjadi .env di server, lalu isi nilai yang bertanda <...>.
# Jangan pernah mengunggah berkas .env ke Git atau membagikannya.
APP_NAME="SIAP-Wisata"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://<domain-resmi>
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Sesi dan cookie
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SIAP_BROWSER_ACCESS_MINUTES=43200

LOG_CHANNEL=daily
LOG_LEVEL=warning
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Database (migrasi saat ini diuji pada MariaDB 10.4; MySQL belum diverifikasi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database>
DB_USERNAME=<user_khusus_aplikasi_bukan_root>
DB_PASSWORD=<sandi_kuat>

# Akun dan data bisnis wajib memakai database di produksi (mode demo ditolak di luar local/testing)
SIAP_DATABASE_ACCOUNTS=true
SIAP_DATABASE_BUSINESS=true

# Isi bila di balik reverse proxy / load balancer: IP proxy dipisah koma, atau * bila server hanya dapat dijangkau lewat proxy.
SIAP_TRUSTED_PROXIES=

# Mulai dengan report-only, ganti ke enforce setelah konsol browser bersih dari pelanggaran.
SIAP_CSP=report-only

# Identitas pada SKRD/STS/STBP. WAJIB diisi dari data resmi dinas sebelum dipakai; bila kosong dokumen mencetak "(belum diatur)".
# Format penomoran resmi menunggu dari dinas; awalan di bawah menggantikan "DEMO".
SIAP_DOC_NUMBER_PREFIX=
SIAP_DOC_BANK=
SIAP_DOC_ACCOUNT=
SIAP_DOC_SIGNER_NAME=
SIAP_DOC_SIGNER_RANK=
SIAP_DOC_SIGNER_NIP=
SIAP_DOC_AUTHORITY_NAME=
SIAP_DOC_AUTHORITY_NIP=
