digraph G { graph [rankdir=LR, splines=polyline, nodesep=0.65, ranksep=1.4, bgcolor="white", pad=0.4]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=10,color="#527285"];
pengguna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>pengguna</B></TD></TR><TR><TD ALIGN="LEFT">pengguna_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">nip</TD><TD ALIGN="LEFT">varchar(20) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar(100) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(150) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">unit_kerja</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">status_akun</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR></TABLE>>];
roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>roles</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">guard_name</TD><TD ALIGN="LEFT">varchar(50) NOT NULL</TD></TR></TABLE>>];
permissions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>permissions</B></TD></TR><TR><TD ALIGN="LEFT">permission_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">guard_name</TD><TD ALIGN="LEFT">varchar(50) NOT NULL</TD></TR></TABLE>>];
model_has_roles [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>model_has_roles</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">bigint PK FK roles</TD></TR><TR><TD ALIGN="LEFT">model_id</TD><TD ALIGN="LEFT">bigint PK REF pengguna</TD></TR><TR><TD ALIGN="LEFT">model_type</TD><TD ALIGN="LEFT">varchar(150) PK</TD></TR></TABLE>>];
role_has_permissions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>role_has_permissions</B></TD></TR><TR><TD ALIGN="LEFT">role_id</TD><TD ALIGN="LEFT">bigint PK FK roles</TD></TR><TR><TD ALIGN="LEFT">permission_id</TD><TD ALIGN="LEFT">bigint PK FK permissions</TD></TR></TABLE>>];
model_has_permissions [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>model_has_permissions</B></TD></TR><TR><TD ALIGN="LEFT">permission_id</TD><TD ALIGN="LEFT">bigint PK FK permissions</TD></TR><TR><TD ALIGN="LEFT">model_id</TD><TD ALIGN="LEFT">bigint PK REF pengguna</TD></TR><TR><TD ALIGN="LEFT">model_type</TD><TD ALIGN="LEFT">varchar(150) PK</TD></TR></TABLE>>];
audit_aktivitas [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>audit_aktivitas</B></TD></TR><TR><TD ALIGN="LEFT">audit_aktivitas_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">aktor_id</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">aksi</TD><TD ALIGN="LEFT">varchar(50) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">jenis_objek</TD><TD ALIGN="LEFT">varchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">objek_id</TD><TD ALIGN="LEFT">bigint NOT NULL REF</TD></TR><TR><TD ALIGN="LEFT">sebelum</TD><TD ALIGN="LEFT">json NULL</TD></TR><TR><TD ALIGN="LEFT">sesudah</TD><TD ALIGN="LEFT">json NULL</TD></TR><TR><TD ALIGN="LEFT">alasan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">terjadi_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR></TABLE>>];
roles -> model_has_roles [dir=none,taillabel="1",headlabel="0..N",label="role_id",style=solid];
pengguna -> model_has_roles [dir=none,taillabel="1",headlabel="0..N",label="model_id",style=dashed];
roles -> role_has_permissions [dir=none,taillabel="1",headlabel="0..N",label="role_id",style=solid];
permissions -> role_has_permissions [dir=none,taillabel="1",headlabel="0..N",label="permission_id",style=solid];
permissions -> model_has_permissions [dir=none,taillabel="1",headlabel="0..N",label="permission_id",style=solid];
pengguna -> model_has_permissions [dir=none,taillabel="1",headlabel="0..N",label="model_id",style=dashed];
pengguna -> audit_aktivitas [dir=none,taillabel="1",headlabel="0..N",label="aktor_id",style=solid];
}