digraph G { graph [rankdir=LR, splines=polyline, nodesep=0.65, ranksep=1.4, bgcolor="white", pad=0.4]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=10,color="#527285"];
pengguna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>pengguna</B></TD></TR><TR><TD ALIGN="LEFT">pengguna_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">nip</TD><TD ALIGN="LEFT">varchar(20) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar(100) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(150) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">unit_kerja</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">status_akun</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR></TABLE>>];
lokasi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>lokasi</B></TD></TR><TR><TD ALIGN="LEFT">lokasi_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nama_lokasi</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status_aktif</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR><TR><TD ALIGN="LEFT">dikelola_dispar</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR></TABLE>>];
jenis_kegiatan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>jenis_kegiatan</B></TD></TR><TR><TD ALIGN="LEFT">jenis_kegiatan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">varchar(150) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">aktif</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR></TABLE>>];
tarif_retribusi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>tarif_retribusi</B></TD></TR><TR><TD ALIGN="LEFT">tarif_retribusi_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">lokasi_id</TD><TD ALIGN="LEFT">bigint FK lokasi</TD></TR><TR><TD ALIGN="LEFT">jenis_kegiatan_id</TD><TD ALIGN="LEFT">bigint FK jenis_kegiatan</TD></TR><TR><TD ALIGN="LEFT">tarif</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL &gt;=0</TD></TR><TR><TD ALIGN="LEFT">satuan</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">berlaku_mulai</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">berlaku_sampai</TD><TD ALIGN="LEFT">date NULL</TD></TR><TR><TD ALIGN="LEFT">ditetapkan_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR></TABLE>>];
permohonan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>permohonan</B></TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nomor_tracking</TD><TD ALIGN="LEFT">varchar(50) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">nama_pemohon</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">penanggung_jawab</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kontak_pemohon</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">email_pemohon</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">alamat_pemohon</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">lokasi_id</TD><TD ALIGN="LEFT">bigint FK lokasi</TD></TR><TR><TD ALIGN="LEFT">jenis_kegiatan_id</TD><TD ALIGN="LEFT">bigint FK jenis_kegiatan</TD></TR><TR><TD ALIGN="LEFT">tanggal_kegiatan</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">jumlah_hari</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">diterima_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(40) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diinput_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">jenis_keringanan</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status_keringanan</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kategori_keringanan</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">alasan_keringanan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">persentase_disetujui</TD><TD ALIGN="LEFT">decimal(5,2) NOT NULL DEFAULT 0</TD></TR><TR><TD ALIGN="LEFT">catatan_keputusan_keringanan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">keringanan_diputuskan_oleh</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">keringanan_diputuskan_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">alasan_hapus</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
jenis_persyaratan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>jenis_persyaratan</B></TD></TR><TR><TD ALIGN="LEFT">jenis_persyaratan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">kode</TD><TD ALIGN="LEFT">varchar(50) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kondisi_wajib</TD><TD ALIGN="LEFT">varchar(40) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">aktif</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR></TABLE>>];
persyaratan_permohonan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>persyaratan_permohonan</B></TD></TR><TR><TD ALIGN="LEFT">persyaratan_permohonan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint FK permohonan</TD></TR><TR><TD ALIGN="LEFT">jenis_persyaratan_id</TD><TD ALIGN="LEFT">bigint FK jenis_persyaratan</TD></TR><TR><TD ALIGN="LEFT">nama_snapshot</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">wajib</TD><TD ALIGN="LEFT">boolean NOT NULL</TD></TR><TR><TD ALIGN="LEFT">alasan_penerapan</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
dokumen_persyaratan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>dokumen_persyaratan</B></TD></TR><TR><TD ALIGN="LEFT">dokumen_persyaratan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">persyaratan_permohonan_id</TD><TD ALIGN="LEFT">bigint FK persyaratan_permohonan</TD></TR><TR><TD ALIGN="LEFT">versi</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">nama_asli</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">disk</TD><TD ALIGN="LEFT">varchar(50) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT">varchar(500) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">mime_type</TD><TD ALIGN="LEFT">varchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">ukuran_byte</TD><TD ALIGN="LEFT">bigint NOT NULL &gt;=0</TD></TR><TR><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT">char(64) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diunggah_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">diunggah_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status_verifikasi</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diverifikasi_oleh</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">diverifikasi_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">catatan_verifikasi</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
lokasi -> tarif_retribusi [dir=none,taillabel="1",headlabel="0..N",label="lokasi_id",style=solid];
jenis_kegiatan -> tarif_retribusi [dir=none,taillabel="1",headlabel="0..N",label="jenis_kegiatan_id",style=solid];
pengguna -> tarif_retribusi [dir=none,taillabel="1",headlabel="0..N",label="ditetapkan_oleh",style=solid];
lokasi -> permohonan [dir=none,taillabel="1",headlabel="0..N",label="lokasi_id",style=solid];
jenis_kegiatan -> permohonan [dir=none,taillabel="1",headlabel="0..N",label="jenis_kegiatan_id",style=solid];
pengguna -> permohonan [dir=none,taillabel="1",headlabel="0..N",label="diinput_oleh",style=solid];
pengguna -> permohonan [dir=none,taillabel="0..1",headlabel="0..N",label="keringanan_diputuskan_oleh",style=solid];
pengguna -> permohonan [dir=none,taillabel="0..1",headlabel="0..N",label="deleted_by",style=solid];
permohonan -> persyaratan_permohonan [dir=none,taillabel="1",headlabel="0..N",label="permohonan_id",style=solid];
jenis_persyaratan -> persyaratan_permohonan [dir=none,taillabel="1",headlabel="0..N",label="jenis_persyaratan_id",style=solid];
persyaratan_permohonan -> dokumen_persyaratan [dir=none,taillabel="1",headlabel="0..N",label="persyaratan_permohonan_id",style=solid];
pengguna -> dokumen_persyaratan [dir=none,taillabel="1",headlabel="0..N",label="diunggah_oleh",style=solid];
pengguna -> dokumen_persyaratan [dir=none,taillabel="0..1",headlabel="0..N",label="diverifikasi_oleh",style=solid];
}