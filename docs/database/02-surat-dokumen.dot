digraph G { graph [rankdir=LR, splines=polyline, nodesep=0.65, ranksep=1.4, bgcolor="white", pad=0.4]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=10,color="#527285"];
pengguna [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>pengguna</B></TD></TR><TR><TD ALIGN="LEFT">pengguna_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nama</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">nip</TD><TD ALIGN="LEFT">varchar(20) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar(100) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar(150) NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT">varchar(255) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">unit_kerja</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">status_akun</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR></TABLE>>];
permohonan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>permohonan</B></TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">nomor_tracking</TD><TD ALIGN="LEFT">varchar(50) NOT NULL UNIQUE</TD></TR><TR><TD ALIGN="LEFT">nama_pemohon</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">penanggung_jawab</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kontak_pemohon</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">email_pemohon</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">alamat_pemohon</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">lokasi_id</TD><TD ALIGN="LEFT">bigint FK lokasi</TD></TR><TR><TD ALIGN="LEFT">jenis_kegiatan_id</TD><TD ALIGN="LEFT">bigint FK jenis_kegiatan</TD></TR><TR><TD ALIGN="LEFT">tanggal_kegiatan</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">jumlah_hari</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">diterima_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(40) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diinput_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">jenis_keringanan</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status_keringanan</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">kategori_keringanan</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">alasan_keringanan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">persentase_disetujui</TD><TD ALIGN="LEFT">decimal(5,2) NOT NULL DEFAULT 0</TD></TR><TR><TD ALIGN="LEFT">catatan_keputusan_keringanan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">keringanan_diputuskan_oleh</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">keringanan_diputuskan_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">deleted_at</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">deleted_by</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">alasan_hapus</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
template_surat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>template_surat</B></TD></TR><TR><TD ALIGN="LEFT">template_surat_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">jenis</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">versi</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">isi_template</TD><TD ALIGN="LEFT">json NOT NULL</TD></TR><TR><TD ALIGN="LEFT">dibuat_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">dipublikasikan_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR></TABLE>>];
draft_surat [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>draft_surat</B></TD></TR><TR><TD ALIGN="LEFT">draft_surat_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint FK permohonan</TD></TR><TR><TD ALIGN="LEFT">template_surat_id</TD><TD ALIGN="LEFT">bigint FK template_surat</TD></TR><TR><TD ALIGN="LEFT">versi</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">nomor_draft</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">tanggal_surat</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">perihal</TD><TD ALIGN="LEFT">varchar(200) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">lampiran</TD><TD ALIGN="LEFT">varchar(200) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">pembuka</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">isi_surat</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">ketentuan</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">penutup</TD><TD ALIGN="LEFT">text NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">alasan_revisi</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">disusun_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">dikirim_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR></TABLE>>];
surat_persetujuan [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>surat_persetujuan</B></TD></TR><TR><TD ALIGN="LEFT">surat_persetujuan_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint FK permohonan UNIQUE</TD></TR><TR><TD ALIGN="LEFT">draft_surat_id</TD><TD ALIGN="LEFT">bigint FK draft_surat</TD></TR><TR><TD ALIGN="LEFT">dirilis_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">dirilis_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR></TABLE>>];
tagihan_retribusi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>tagihan_retribusi</B></TD></TR><TR><TD ALIGN="LEFT">tagihan_retribusi_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint FK permohonan UNIQUE</TD></TR><TR><TD ALIGN="LEFT">periode_retribusi</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">npwr</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">tanggal_jatuh_tempo</TD><TD ALIGN="LEFT">date NULL</TD></TR><TR><TD ALIGN="LEFT">keterangan_jatuh_tempo</TD><TD ALIGN="LEFT">varchar(200) NULL</TD></TR><TR><TD ALIGN="LEFT">subtotal</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL &gt;=0</TD></TR><TR><TD ALIGN="LEFT">persentase_potongan</TD><TD ALIGN="LEFT">decimal(5,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">nominal_potongan</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL &gt;=0</TD></TR><TR><TD ALIGN="LEFT">persentase_denda</TD><TD ALIGN="LEFT">decimal(5,2) NOT NULL DEFAULT 0</TD></TR><TR><TD ALIGN="LEFT">nominal_denda</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL DEFAULT 0</TD></TR><TR><TD ALIGN="LEFT">nominal_kenaikan</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL DEFAULT 0</TD></TR><TR><TD ALIGN="LEFT">dasar_sanksi</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">jumlah_tagihan</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL &gt;=0</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(25) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diterbitkan_oleh</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">diterbitkan_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">catatan_penetapan</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
pembayaran [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>pembayaran</B></TD></TR><TR><TD ALIGN="LEFT">pembayaran_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">tagihan_retribusi_id</TD><TD ALIGN="LEFT">bigint FK tagihan_retribusi UNIQUE</TD></TR><TR><TD ALIGN="LEFT">jumlah_bayar</TD><TD ALIGN="LEFT">decimal(18,2) NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">tanggal_bayar</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">metode</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">bank</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">nomor_rekening</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">referensi_transaksi</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_disk</TD><TD ALIGN="LEFT">varchar(50) NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_path</TD><TD ALIGN="LEFT">varchar(500) NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_nama</TD><TD ALIGN="LEFT">varchar(255) NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_mime</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_ukuran_byte</TD><TD ALIGN="LEFT">bigint NULL</TD></TR><TR><TD ALIGN="LEFT">bukti_sha256</TD><TD ALIGN="LEFT">char(64) NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">diinput_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">diverifikasi_oleh</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">diverifikasi_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">catatan</TD><TD ALIGN="LEFT">text NULL</TD></TR></TABLE>>];
dokumen_terbit [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>dokumen_terbit</B></TD></TR><TR><TD ALIGN="LEFT">dokumen_terbit_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">jenis</TD><TD ALIGN="LEFT">varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">surat_persetujuan_id</TD><TD ALIGN="LEFT">bigint NULL FK surat_persetujuan UNIQUE</TD></TR><TR><TD ALIGN="LEFT">tagihan_retribusi_id</TD><TD ALIGN="LEFT">bigint NULL FK tagihan_retribusi UNIQUE</TD></TR><TR><TD ALIGN="LEFT">pembayaran_id</TD><TD ALIGN="LEFT">bigint NULL FK pembayaran</TD></TR><TR><TD ALIGN="LEFT">nomor_dokumen</TD><TD ALIGN="LEFT">varchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT">tahun_nomor</TD><TD ALIGN="LEFT">integer NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR></TABLE>>];
versi_dokumen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>versi_dokumen</B></TD></TR><TR><TD ALIGN="LEFT">versi_dokumen_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">dokumen_terbit_id</TD><TD ALIGN="LEFT">bigint FK dokumen_terbit</TD></TR><TR><TD ALIGN="LEFT">template_surat_id</TD><TD ALIGN="LEFT">bigint NULL FK template_surat</TD></TR><TR><TD ALIGN="LEFT">versi</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">tanggal_dokumen</TD><TD ALIGN="LEFT">date NOT NULL</TD></TR><TR><TD ALIGN="LEFT">sumber</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">data_snapshot</TD><TD ALIGN="LEFT">json NOT NULL</TD></TR><TR><TD ALIGN="LEFT">disk</TD><TD ALIGN="LEFT">varchar(50) NULL</TD></TR><TR><TD ALIGN="LEFT">file_path</TD><TD ALIGN="LEFT">varchar(500) NULL</TD></TR><TR><TD ALIGN="LEFT">nama_asli</TD><TD ALIGN="LEFT">varchar(255) NULL</TD></TR><TR><TD ALIGN="LEFT">mime_type</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">ukuran_byte</TD><TD ALIGN="LEFT">bigint NULL</TD></TR><TR><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT">char(64) NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">dibuat_oleh</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">alasan_revisi</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">final_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR></TABLE>>];
tanda_tangan_dokumen [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>tanda_tangan_dokumen</B></TD></TR><TR><TD ALIGN="LEFT">tanda_tangan_dokumen_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">versi_dokumen_id</TD><TD ALIGN="LEFT">bigint FK versi_dokumen</TD></TR><TR><TD ALIGN="LEFT">urutan</TD><TD ALIGN="LEFT">integer NOT NULL &gt;0</TD></TR><TR><TD ALIGN="LEFT">pengguna_id</TD><TD ALIGN="LEFT">bigint NULL FK pengguna</TD></TR><TR><TD ALIGN="LEFT">nama_snapshot</TD><TD ALIGN="LEFT">varchar(150) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">nip_snapshot</TD><TD ALIGN="LEFT">varchar(20) NULL</TD></TR><TR><TD ALIGN="LEFT">jabatan_snapshot</TD><TD ALIGN="LEFT">varchar(200) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">pangkat_snapshot</TD><TD ALIGN="LEFT">varchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT">metode</TD><TD ALIGN="LEFT">varchar(25) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">varchar(20) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">ditandatangani_pada</TD><TD ALIGN="LEFT">datetime NULL</TD></TR><TR><TD ALIGN="LEFT">referensi_penyedia</TD><TD ALIGN="LEFT">varchar(200) NULL</TD></TR><TR><TD ALIGN="LEFT">hash_dokumen_ditandatangani</TD><TD ALIGN="LEFT">char(64) NULL</TD></TR></TABLE>>];
riwayat_disposisi [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" COLOR="#8197A3"><TR><TD COLSPAN="2" BGCOLOR="#E6EFF2"><B>riwayat_disposisi</B></TD></TR><TR><TD ALIGN="LEFT">riwayat_disposisi_id</TD><TD ALIGN="LEFT">bigint PK</TD></TR><TR><TD ALIGN="LEFT">permohonan_id</TD><TD ALIGN="LEFT">bigint FK permohonan</TD></TR><TR><TD ALIGN="LEFT">aktor_id</TD><TD ALIGN="LEFT">bigint FK pengguna</TD></TR><TR><TD ALIGN="LEFT">role_snapshot</TD><TD ALIGN="LEFT">varchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">status_sebelum</TD><TD ALIGN="LEFT">varchar(40) NULL</TD></TR><TR><TD ALIGN="LEFT">status_sesudah</TD><TD ALIGN="LEFT">varchar(40) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">aksi</TD><TD ALIGN="LEFT">varchar(50) NOT NULL</TD></TR><TR><TD ALIGN="LEFT">draft_surat_id</TD><TD ALIGN="LEFT">bigint NULL FK draft_surat</TD></TR><TR><TD ALIGN="LEFT">versi_dokumen_id</TD><TD ALIGN="LEFT">bigint NULL FK versi_dokumen</TD></TR><TR><TD ALIGN="LEFT">catatan</TD><TD ALIGN="LEFT">text NULL</TD></TR><TR><TD ALIGN="LEFT">terjadi_pada</TD><TD ALIGN="LEFT">datetime NOT NULL</TD></TR></TABLE>>];
