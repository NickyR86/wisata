        "rule": "NOT NULL",
        "meaning": "Keterangan lampiran"
      },
      {
        "name": "pembuka",
        "type": "text",
        "rule": "NOT NULL",
        "meaning": "Narasi pembuka"
      },
      {
        "name": "isi_surat",
        "type": "text",
        "rule": "NOT NULL",
