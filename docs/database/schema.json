{
  "pengguna": {
    "purpose": "Akun internal; dikelola tim teknologi, bukan akun pemohon.",
    "fields": [
      {
        "name": "pengguna_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas akun"
      },
      {
        "name": "nama",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Nama pengguna"
      },
      {
        "name": "nip",
        "type": "varchar(20)",
        "rule": "NULL UNIQUE",
        "meaning": "NIP sebagai teks"
      },
      {
        "name": "username",
        "type": "varchar(100)",
        "rule": "NOT NULL UNIQUE",
        "meaning": "Alternatif login dan akun tanpa NIP"
      },
      {
        "name": "email",
        "type": "varchar(150)",
        "rule": "NULL UNIQUE",
        "meaning": "Kontak akun"
      },
      {
        "name": "password",
        "type": "varchar(255)",
        "rule": "NOT NULL",
        "meaning": "Hash password, tidak pernah plaintext"
      },
      {
        "name": "unit_kerja",
        "type": "varchar(150)",
        "rule": "NULL",
        "meaning": "Unit organisasi"
      },
      {
        "name": "status_akun",
        "type": "varchar(20)",
        "rule": "NOT NULL",
        "meaning": "aktif atau nonaktif"
      }
    ],
    "rules": "Normalisasi username/NIP sebelum validasi. Username tidak boleh sama dengan NIP akun lain; cek lintas kolom dalam layanan pengelolaan akun. Akun historis dinonaktifkan, bukan dihapus. Role dari pivot, bukan kolom paralel."
  },
  "lokasi": {
    "purpose": "Master lokasi kegiatan.",
    "fields": [
      {
        "name": "lokasi_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas lokasi"
      },
      {
        "name": "nama_lokasi",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Nama tempat"
      },
      {
        "name": "status_aktif",
        "type": "boolean",
        "rule": "NOT NULL",
        "meaning": "Boleh dipilih untuk permohonan baru"
      },
      {
        "name": "dikelola_dispar",
        "type": "boolean",
        "rule": "NOT NULL",
        "meaning": "Atribut sumber keputusan kelayakan yang sudah dibahas"
      }
    ],
    "rules": ""
  },
  "jenis_kegiatan": {
    "purpose": "Nama kegiatan konsisten antara permohonan dan tarif.",
    "fields": [
      {
        "name": "jenis_kegiatan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas jenis kegiatan"
      },
      {
        "name": "nama",
        "type": "varchar(150)",
        "rule": "NOT NULL UNIQUE",
        "meaning": "Nama kategori kegiatan"
      },
      {
        "name": "aktif",
        "type": "boolean",
        "rule": "NOT NULL",
        "meaning": "Ketersediaan pilihan"
      }
    ],
    "rules": ""
  },
  "tarif_retribusi": {
    "purpose": "Tarif berdasarkan lokasi, jenis kegiatan dan masa berlaku.",
    "fields": [
      {
        "name": "tarif_retribusi_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas versi tarif"
      },
      {
        "name": "lokasi_id",
        "type": "bigint",
        "rule": "FK lokasi",
        "meaning": "Lokasi"
      },
      {
        "name": "jenis_kegiatan_id",
        "type": "bigint",
        "rule": "FK jenis_kegiatan",
        "meaning": "Jenis kegiatan"
      },
      {
        "name": "tarif",
        "type": "decimal(18,2)",
        "rule": "NOT NULL >=0",
        "meaning": "Tarif satuan"
      },
      {
        "name": "satuan",
        "type": "varchar(20)",
        "rule": "NOT NULL",
        "meaning": "hari untuk lingkup sekarang"
      },
      {
        "name": "berlaku_mulai",
        "type": "date",
        "rule": "NOT NULL",
        "meaning": "Awal berlaku"
      },
      {
        "name": "berlaku_sampai",
        "type": "date",
        "rule": "NULL",
        "meaning": "Akhir berlaku inklusif"
      },
      {
        "name": "ditetapkan_oleh",
        "type": "bigint",
        "rule": "FK pengguna",
        "meaning": "Admin penginput master"
      }
    ],
    "rules": "UNIQUE(lokasi_id, jenis_kegiatan_id, berlaku_mulai). Akhir >= awal. Rentang untuk pasangan lokasi/kegiatan tidak boleh tumpang tindih: validasi transaksional dengan kunci pasangan. Tarif yang sudah dirujuk tidak ditimpa; buat versi baru."
  },
  "permohonan": {
    "purpose": "Satu pengajuan; identitas pemohon disimpan per pengajuan.",
    "fields": [
      {
        "name": "permohonan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas permohonan"
      },
      {
        "name": "nomor_tracking",
        "type": "varchar(50)",
        "rule": "NOT NULL UNIQUE",
        "meaning": "Nomor pencarian, bukan PK"
      },
      {
        "name": "nama_pemohon",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Nama organisasi atau individu"
      },
      {
        "name": "penanggung_jawab",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Orang yang mengurus kegiatan"
      },
      {
        "name": "kontak_pemohon",
        "type": "varchar(30)",
        "rule": "NOT NULL",
        "meaning": "Telepon/WhatsApp berupa teks"
      },
      {
        "name": "email_pemohon",
        "type": "varchar(150)",
        "rule": "NULL",
        "meaning": "Email pemohon"
      },
      {
        "name": "alamat_pemohon",
        "type": "text",
        "rule": "NOT NULL",
        "meaning": "Alamat untuk dokumen"
      },
      {
        "name": "lokasi_id",
        "type": "bigint",
        "rule": "FK lokasi",
        "meaning": "Lokasi kegiatan"
      },
      {
        "name": "jenis_kegiatan_id",
        "type": "bigint",
        "rule": "FK jenis_kegiatan",
        "meaning": "Kategori kegiatan"
      },
      {
        "name": "tanggal_kegiatan",
        "type": "date",
        "rule": "NOT NULL",
        "meaning": "Hari pertama"
      },
      {
        "name": "jumlah_hari",
        "type": "integer",
        "rule": "NOT NULL >0",
        "meaning": "Durasi kegiatan"
      },
      {
        "name": "diterima_pada",
        "type": "datetime",
        "rule": "NOT NULL",
        "meaning": "Awal pencatatan layanan"
      },
      {
        "name": "status",
        "type": "varchar(40)",
        "rule": "NOT NULL",
        "meaning": "Status proses dari daftar transisi"
      },
      {
        "name": "diinput_oleh",
        "type": "bigint",
        "rule": "FK pengguna",
        "meaning": "Petugas pencatat"
      },
      {
        "name": "jenis_keringanan",
        "type": "varchar(20)",
        "rule": "NOT NULL",
        "meaning": "normal, pengurangan, pembebasan"
      },
      {
        "name": "status_keringanan",
        "type": "varchar(20)",
        "rule": "NOT NULL",
        "meaning": "tidak_diajukan, diajukan, disetujui, ditolak"
      },
      {
        "name": "kategori_keringanan",
        "type": "varchar(100)",
        "rule": "NULL",
        "meaning": "Kategori dasar pengajuan"
      },
      {
        "name": "alasan_keringanan",
        "type": "text",
        "rule": "NULL",
        "meaning": "Alasan pemohon"
      },
      {
        "name": "persentase_disetujui",
        "type": "decimal(5,2)",
        "rule": "NOT NULL DEFAULT 0",
        "meaning": "0..100; 25 untuk pengurangan yang disetujui, 100 pembebasan"
      },
      {
        "name": "catatan_keputusan_keringanan",
        "type": "text",
        "rule": "NULL",
        "meaning": "Dasar keputusan"
      },
      {
        "name": "keringanan_diputuskan_oleh",
        "type": "bigint",
        "rule": "NULL FK pengguna",
        "meaning": "Akun pengambil keputusan"
      },
      {
        "name": "keringanan_diputuskan_pada",
        "type": "datetime",
        "rule": "NULL",
        "meaning": "Waktu keputusan"
      },
      {
        "name": "deleted_at",
        "type": "datetime",
        "rule": "NULL",
        "meaning": "Hapus sementara"
      },
      {
        "name": "deleted_by",
        "type": "bigint",
        "rule": "NULL FK pengguna",
        "meaning": "Penghapus"
      },
      {
        "name": "alasan_hapus",
        "type": "text",
        "rule": "NULL",
        "meaning": "Alasan penghapusan"
      }
    ],
    "rules": "Tanggal selesai dihitung tanggal_kegiatan + jumlah_hari - 1. Tidak menyimpan total harga perkiraan di permohonan. Keputusan keringanan menyimpan pelaku/waktu berpasangan; keputusan sebelumnya tetap di audit. Hapus/pulihkan tidak mengubah status proses."
  },
  "jenis_persyaratan": {
    "purpose": "Katalog dokumen dan kondisi kewajibannya.",
    "fields": [
      {
        "name": "jenis_persyaratan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas persyaratan"
      },
      {
        "name": "kode",
        "type": "varchar(50)",
        "rule": "NOT NULL UNIQUE",
        "meaning": "Kode stabil"
      },
      {
        "name": "nama",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Nama dokumen"
      },
      {
        "name": "kondisi_wajib",
        "type": "varchar(40)",
        "rule": "NOT NULL",
        "meaning": "selalu, jika_impresariat, jika_keringanan, opsional"
      },
      {
        "name": "aktif",
        "type": "boolean",
        "rule": "NOT NULL",
        "meaning": "Aktif untuk pengajuan baru"
      }
    ],
    "rules": "Kondisi dievaluasi server dengan konteks pemohon; bukan kode yang dieksekusi dari database. Perubahan katalog tidak mengubah persyaratan pengajuan lama."
  },
  "persyaratan_permohonan": {
    "purpose": "Daftar persyaratan yang berlaku, termasuk yang belum diunggah.",
    "fields": [
      {
        "name": "persyaratan_permohonan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas checklist"
      },
      {
        "name": "permohonan_id",
        "type": "bigint",
        "rule": "FK permohonan",
        "meaning": "Pengajuan"
      },
      {
        "name": "jenis_persyaratan_id",
        "type": "bigint",
        "rule": "FK jenis_persyaratan",
        "meaning": "Sumber aturan"
      },
      {
        "name": "nama_snapshot",
        "type": "varchar(150)",
        "rule": "NOT NULL",
        "meaning": "Nama saat aturan diterapkan"
      },
      {
        "name": "wajib",
        "type": "boolean",
        "rule": "NOT NULL",
        "meaning": "Hasil evaluasi kewajiban saat intake"
      },
      {
        "name": "alasan_penerapan",
        "type": "text",
        "rule": "NULL",
        "meaning": "Contoh: jasa impresariat tidak digunakan"
      }
    ],
    "rules": "UNIQUE(permohonan_id, jenis_persyaratan_id). Checklist terisi sebelum unggah. Kelengkapan dihitung dari dokumen terbaru yang diterima untuk semua item wajib."
  },
  "dokumen_persyaratan": {
    "purpose": "Versi unggahan tiap item persyaratan; penggantian tidak menimpa file lama.",
    "fields": [
      {
        "name": "dokumen_persyaratan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas versi berkas"
      },
      {
        "name": "persyaratan_permohonan_id",
        "type": "bigint",
        "rule": "FK persyaratan_permohonan",
        "meaning": "Item checklist"
      },
      {
        "name": "versi",
        "type": "integer",
        "rule": "NOT NULL >0",
        "meaning": "Urutan unggahan"
      },
      {
        "name": "nama_asli",
        "type": "varchar(255)",
        "rule": "NOT NULL",
        "meaning": "Nama untuk tampilan"
      },
      {
        "name": "disk",
        "type": "varchar(50)",
        "rule": "NOT NULL",
        "meaning": "Penyimpanan privat"
      },
      {
        "name": "file_path",
        "type": "varchar(500)",
        "rule": "NOT NULL",
        "meaning": "Key berkas, bukan path komputer pengguna"
      },
      {
        "name": "mime_type",
        "type": "varchar(100)",
        "rule": "NOT NULL",
        "meaning": "Tipe hasil pemeriksaan server"
      },
      {
        "name": "ukuran_byte",
        "type": "bigint",
        "rule": "NOT NULL >=0",
        "meaning": "Ukuran file"
      },
      {
        "name": "sha256",
        "type": "char(64)",
        "rule": "NOT NULL",
        "meaning": "Sidik isi berkas"
      },
      {
        "name": "diunggah_oleh",
        "type": "bigint",
        "rule": "FK pengguna",
        "meaning": "Pengunggah"
      },
      {
        "name": "diunggah_pada",
        "type": "datetime",
        "rule": "NOT NULL",
        "meaning": "Waktu unggah"
      },
      {
        "name": "status_verifikasi",
        "type": "varchar(20)",
        "rule": "NOT NULL",
        "meaning": "menunggu, diterima, ditolak"
      },
      {
        "name": "diverifikasi_oleh",
        "type": "bigint",
        "rule": "NULL FK pengguna",
        "meaning": "Pemeriksa"
      },
      {
        "name": "diverifikasi_pada",
        "type": "datetime",
        "rule": "NULL",
        "meaning": "Waktu pemeriksaan"
      },
      {
        "name": "catatan_verifikasi",
        "type": "text",
        "rule": "NULL",
        "meaning": "Alasan koreksi"
      }
    ],
    "rules": "UNIQUE(persyaratan_permohonan_id, versi). Yang terbaru adalah versi terbesar; tidak menggandakan flag aktif. Versi lama immutable setelah diganti. Penolakan berkas wajib memiliki catatan."
  },
  "template_surat": {
    "purpose": "Versi format sistem untuk surat dan dokumen keuangan.",
    "fields": [
      {
        "name": "template_surat_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas versi template"
      },
      {
        "name": "jenis",
        "type": "varchar(30)",
        "rule": "NOT NULL",
        "meaning": "persetujuan, skrd, stbp, sts"
      },
      {
        "name": "versi",
        "type": "integer",
        "rule": "NOT NULL >0",
        "meaning": "Versi template"
      },
      {
        "name": "isi_template",
        "type": "json",
        "rule": "NOT NULL",
        "meaning": "Struktur field dan teks; bukan kode PHP bebas"
      },
      {
        "name": "dibuat_oleh",
        "type": "bigint",
        "rule": "FK pengguna",
        "meaning": "Admin pengelola"
      },
      {
        "name": "dipublikasikan_pada",
        "type": "datetime",
        "rule": "NULL",
        "meaning": "NULL berarti belum boleh dipakai"
      }
    ],
    "rules": "UNIQUE(jenis, versi). Versi terpublikasi immutable; pemilihan default menggunakan versi terpublikasi terakhir. Revisi membuat baris baru."
  },
  "draft_surat": {
    "purpose": "Isi surat per versi; petugas menyusun, Kabid/Sekretaris meninjau.",
    "fields": [
      {
        "name": "draft_surat_id",
