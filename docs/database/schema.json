      {
        "name": "surat_persetujuan_id",
        "type": "bigint",
        "rule": "PK",
        "meaning": "Identitas surat"
      },
      {
        "name": "permohonan_id",
        "type": "bigint",
        "rule": "FK permohonan UNIQUE",
        "meaning": "Satu surat logis per permohonan"
      },
      {
        "name": "draft_surat_id",
        "type": "bigint",
        "rule": "FK draft_surat",
        "meaning": "Versi yang dirilis"
      },
      {
        "name": "dirilis_oleh",
        "type": "bigint",
        "rule": "FK pengguna",
