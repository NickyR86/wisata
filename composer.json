{
    "name": "siap-wisata/frontend-demo",
    "type": "project",
    "description": "Frontend demonstrasi SIAP-Wisata — Laravel Blade dan Bootstrap",
    "license": "proprietary",
    "require": { "php": "^8.2", "laravel/framework": "^12.0" },
    "autoload": { "psr-4": { "App\\": "app/" } },
    "scripts": { "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"] },
    "config": { "optimize-autoloader": false, "preferred-install": "dist", "sort-packages": true },
    "minimum-stability": "stable",
    "prefer-stable": true
}
